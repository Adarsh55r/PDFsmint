# =============================================================================
# PDFsMint — Production environment variables
# =============================================================================
# Copy the relevant values into your Vercel project settings:
#   Vercel Dashboard → your project → Settings → Environment Variables
#
# Do NOT commit real .env files. Only this *.example file is tracked in git.
# -----------------------------------------------------------------------------

# The public, absolute base URL of the deployed site (NO trailing slash).
# Used for canonical tags, sitemap.xml, robots.txt, and OG/Twitter share URLs.
#
# Set this in Vercel (Production) and redeploy after any change — NEXT_PUBLIC_*
# values are baked in at build time.
#
#   Custom domain (current):
#     NEXT_PUBLIC_SITE_URL=https://www.pdfsmint.com
#
#   Apex without www (only if you make apex canonical later):
#     NEXT_PUBLIC_SITE_URL=https://pdfsmint.com
NEXT_PUBLIC_SITE_URL=https://www.pdfsmint.com
